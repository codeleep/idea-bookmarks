{
  "name": "branches: feature or fixbug",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/feature/*",
        "refs/heads/feature/**/*",
        "refs/heads/fixbug/*",
        "refs/heads/fixbug/**/*"
      ]
    }
  },
  "rules": [
    {"type": "creation"},
    {"type": "update", "parameters": {"update_allows_fetch_and_merge": false}}
  ]
}
